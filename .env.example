# =============================================================================
# Local docker-compose env. Copy to .env and fill in. (.env is gitignored.)
# Variable names are the exact ones useSend reads (from its prod compose).
# For the AWS deployment these are set by Terraform instead — see terraform/.
# =============================================================================

PORT=3000
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 33
NEXTAUTH_SECRET=

# ---- Postgres (matches docker-compose.yml) ----
POSTGRES_USER=usesend
POSTGRES_PASSWORD=usesend
POSTGRES_DB=usesend
DATABASE_URL=postgresql://usesend:usesend@postgres:5432/usesend

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Auth (at least ONE provider required) ----
# GitHub OAuth App callback (local): http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
# Optional alternative:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- AWS for SES/SNS sending ----
# Leave blank to just explore the UI. To actually send locally, put an IAM
# user's keys here (needs AmazonSESFullAccess + AmazonSNSFullAccess), and note
# your SES account must be out of sandbox to email unverified recipients.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

NEXT_PUBLIC_IS_CLOUD=false
API_RATE_LIMIT=1

# ---- Object storage (OPTIONAL — editor image uploads only; leave unset) ----
# S3_COMPATIBLE_API_URL=
# S3_COMPATIBLE_PUBLIC_URL=
# S3_COMPATIBLE_ACCESS_KEY=
# S3_COMPATIBLE_SECRET_KEY=
# S3_COMPATIBLE_BUCKET=
